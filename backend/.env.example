# ===== Server =====
PORT=4000
FRONTEND_URL=http://localhost:3000

# ===== Hạ tầng (khớp với docker-compose.yml) =====
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm
REDIS_URL=redis://localhost:6379

# ===== Đăng nhập dashboard =====
JWT_SECRET=doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai
JWT_EXPIRES_IN=7d
# Tài khoản admin được tạo tự động lần chạy đầu tiên (khi DB chưa có user nào)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# ===== LLM: Claude (https://console.anthropic.com) =====
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-opus-5-5
# low | medium | high — chat CSKH thường "low" là đủ nhanh và rẻ
LLM_EFFORT=low

# ===== Embeddings cho RAG: Voyage AI (https://www.voyageai.com) =====
VOYAGE_API_KEY=pa-...
EMBEDDING_MODEL=voyage-3.5
# Phải khớp với vector(1024) trong prisma/schema.prisma

# ===== Facebook Messenger =====
MESSENGER_VERIFY_TOKEN=mot-chuoi-bi-mat-tu-dat
MESSENGER_APP_SECRET=
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_GRAPH_VERSION=v21.0

# ===== Zalo Official Account =====
ZALO_APP_ID=
ZALO_OA_SECRET_KEY=
ZALO_OA_ACCESS_TOKEN=
